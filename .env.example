# Copy to .env (`make setup` does this). Never commit .env.
# Every setting is documented in docs/DEVELOPMENT.md#configuration.

# --- SerpApi -------------------------------------------------------------
# Only needed for live / record mode. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# replay: fixtures only, no network (default) · live: real API via cache + budget
# record: live, and also save responses to backend/fixtures/
SERPAPI_MODE=replay
SERPAPI_MONTHLY_BUDGET=250
SERPAPI_RUN_BUDGET=45
SERPAPI_CACHE_TTL_HOURS=72
SERPAPI_LOCATION=Bengaluru,Karnataka,India
# Some searches take over 30 s (S-01); timed-out searches were not charged.
SERPAPI_TIMEOUT_S=60

# --- DeepSeek ------------------------------------------------------------
# Only needed for live / record mode. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
LLM_MODE=replay
# Both tiers use V4 Pro: reasoning runs with thinking on, lite (extraction) with it off.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_LITE=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_TIMEOUT_S=120
# Candidates checked per run (~2 DeepSeek calls each). Replay fixtures cover the first 16.
VERIFY_MAX_CANDIDATES=16

# --- App -----------------------------------------------------------------
AREA_INTEL_TTL_HOURS=168
# Scheduled alert checks spend live searches; keep off unless you mean it.
SCHEDULER_ENABLED=false
ALERT_CHECK_INTERVAL_MINUTES=360
# DATABASE_URL defaults to backend/data/realty_intel.db
# CORS_ORIGINS=["http://localhost:5173"]
